package com.java;
import java.util.*;
public class LeftRotate {
	public static void main(String[]args) {
		Scanner sc= new Scanner(System.in);
		int n=sc.nextInt();
		int []arr=new int [n];
		
		for(int i=0;i<n;i++) {
			arr[i]=sc.nextInt();
		}
		
		int k=sc.nextInt();
		k=k%arr.length;
		for(int p=1;p<=k;p++) {
			int temp=arr[0];
		for(int i=1;i<arr.length;i++) {
			arr[i-1]=arr[i];
		}
			arr[arr.length-1]=temp;
		
		
	}
		System.out.print(Arrays.toString(arr));
	}
}
