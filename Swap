package com.java;
import java.util.*;
public class Swap {
	public static void main(String[]args) {
		Scanner sc= new Scanner(System.in);
		int n=sc.nextInt();
		int []arr=new int [n];
		for(int i=0;i<n;i++) {
			arr[i]=sc.nextInt();
		}
	     //int temp=0;
		//temp=arr[0];
    	//arr[0]=arr[arr.length];
    	//arr[arr.length]=temp;
		int temp = arr[0];
		arr[0] = arr[arr.length - 1];
		arr[arr.length - 1] = temp;
		for (int i = 0; i < arr.length; i++) { 
			System.out.print(arr[i] + " ");
		}
	}

}
